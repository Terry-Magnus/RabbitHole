# Copy the relevant values into apps/web/.env.local and services/api/.env
# This file is documentation only — apps do not read it directly.

# services/api
# Uses a dedicated low-privilege role/database on your local Postgres install
# (not the postgres superuser) — see context/project-tracker.md for how it was created.
DATABASE_URL=postgresql://rabbithole_app:<password>@localhost:5432/rabbithole
REDIS_URL=redis://localhost:6379
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:4000
PORT=4000
# Origin allowed by CORS to call the API — must match whatever port apps/web
# actually runs on. Defaults to :3000; override if that port is unavailable
# on your machine (Next.js will auto-fallback to :3001, :3002, ... and you'll
# need to match it here).
WEB_APP_ORIGIN=http://localhost:3000
# Where uploaded images are written, relative to services/api/. Defaults to
# "uploads" if unset — local disk storage for now (architecture.md still
# names Cloudflare R2 as the long-term intent; see context/project-tracker.md).
UPLOADS_DIR=uploads
# Comma-separated. Registering with one of these emails becomes an
# Administrator automatically; everyone else registers as a plain user.
# Set this BEFORE your own first registration — see context/project-tracker.md
# for the one-line SQL fallback if you forget.
ADMIN_EMAILS=

# apps/web
NEXT_PUBLIC_API_URL=http://localhost:4000
